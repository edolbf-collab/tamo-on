/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://unpkg.com https://accounts.google.com https://static.cloudflareinsights.com/beacon.min.js; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://accounts.google.com https://cloudflareinsights.com; img-src 'self' data: blob: https://*.googleusercontent.com https://*.ggpht.com; frame-src https://accounts.google.com; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/manifest.json
  Cache-Control: no-cache, max-age=0, must-revalidate
/manifest.webmanifest
  Cache-Control: no-cache, max-age=0, must-revalidate
/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate
/pwa-bootstrap.js
  Cache-Control: no-cache, max-age=0, must-revalidate
/app.js
  Cache-Control: no-cache, no-store, must-revalidate
/styles.css
  Cache-Control: no-cache, max-age=0, must-revalidate
/version.json
  Cache-Control: no-cache, no-store, must-revalidate
/group-avatars-data.js
  Cache-Control: no-cache, max-age=0, must-revalidate
/brand/*
  Cache-Control: public, max-age=31536000, immutable
/assets/group-avatars-build-140/*
  Cache-Control: public, max-age=31536000, immutable
/tamo-on-icon-192.png
  Cache-Control: public, max-age=31536000, immutable
/tamo-on-icon-512.png
  Cache-Control: public, max-age=31536000, immutable
/tamo-on-maskable-192.png
  Cache-Control: public, max-age=31536000, immutable
/tamo-on-maskable-512.png
  Cache-Control: public, max-age=31536000, immutable
